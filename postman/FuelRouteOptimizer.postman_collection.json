{
  "info": {
    "name": "Fuel Route Optimizer",
    "description": "Cheapest fuel stops between two US locations. Start the server (`python manage.py runserver`), send a request, then open the **Visualize** tab to see the map.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Plan route: Chicago to Dallas (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/route/?start=Chicago, IL&finish=Dallas, TX",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Chicago, IL"
            },
            {
              "key": "finish",
              "value": "Dallas, TX"
            }
          ]
        },
        "description": "City, ST inputs are resolved offline: one routing call, zero when repeated."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"has fuel stops and a total cost\", () => {",
              "  pm.expect(body.fuel_stops).to.be.an(\"array\");",
              "  pm.expect(body.summary.total_fuel_cost).to.be.a(\"number\");",
              "});",
              "pm.test(\"stop costs add up to the total\", () => {",
              "  const sum = body.fuel_stops.reduce((acc, s) => acc + s.cost, 0);",
              "  pm.expect(sum).to.be.closeTo(body.summary.total_fuel_cost, 0.01);",
              "});",
              "pm.test(\"buys exactly the fuel the trip burns (miles / 10 mpg)\", () => {",
              "  pm.expect(body.summary.total_gallons_purchased).to.be.closeTo(body.route.distance_miles / 10, 0.01);",
              "});",
              "pm.test(\"at most one routing API call\", () => pm.expect(body.meta.external_api_calls.routing).to.be.at.most(1));",
              "",
              "const template = `",
              "<link rel=\"stylesheet\" href=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.css\">",
              "<script src=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.js\"></script>",
              "<div style=\"font:14px system-ui;margin-bottom:6px\" id=\"summary\"></div>",
              "<div id=\"map\" style=\"height:520px\"></div>",
              "<script>",
              "pm.getData((err, plan) => {",
              "  const summary = document.getElementById(\"summary\");",
              "  if (plan.error) { summary.textContent = plan.error.message; return; }",
              "  const s = plan.summary;",
              "  summary.innerHTML = \"<b>\" + plan.start.label + \" &rarr; \" + plan.finish.label + \"</b> &middot; \" +",
              "    plan.route.distance_miles + \" mi &middot; \" + s.number_of_stops + \" stops &middot; <b>$\" +",
              "    s.total_fuel_cost.toFixed(2) + \"</b> for \" + s.total_gallons_purchased.toFixed(1) + \" gal\";",
              "  const map = L.map(\"map\");",
              "  L.tileLayer(\"https://tile.openstreetmap.org/{z}/{x}/{y}.png\", {attribution: \"&copy; OpenStreetMap\"}).addTo(map);",
              "  const colors = {start: \"#15803d\", finish: \"#b91c1c\", fuel_stop: \"#f59e0b\"};",
              "  const layer = L.geoJSON(plan.map.geojson, {",
              "    style: {color: \"#2563eb\", weight: 5},",
              "    pointToLayer: (f, latlng) => L.circleMarker(latlng, {radius: f.properties.kind === \"fuel_stop\" ? 9 : 7,",
              "      weight: 2, color: \"#fff\", fillOpacity: 1, fillColor: colors[f.properties.kind]}),",
              "    onEachFeature: (f, l) => {",
              "      const p = f.properties;",
              "      if (p.kind === \"fuel_stop\") l.bindTooltip(\"Stop \" + p.stop + \": \" + p.name + \" ($\" + p.price_per_gallon +",
              "        \"/gal, \" + p.gallons.toFixed(1) + \" gal)\");",
              "      else if (p.label) l.bindTooltip(p.label);",
              "    },",
              "  }).addTo(map);",
              "  map.fitBounds(layer.getBounds(), {padding: [20, 20]});",
              "});",
              "</script>`;",
              "pm.visualizer.set(template, pm.response.json());"
            ]
          }
        }
      ]
    },
