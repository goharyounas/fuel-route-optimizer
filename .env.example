# Every setting is optional; the defaults work for local development.
# Export these in your shell or process manager (settings.py reads os.environ).

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Vehicle and planning model
VEHICLE_RANGE_MILES=500
VEHICLE_MPG=10
FUEL_RESERVE_MILES=50
STOP_COST_USD=15
ROUTE_CORRIDOR_MILES=5

# Free upstream services (point at self-hosted instances for production traffic)
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
HTTP_TIMEOUT_SECONDS=20

# Share the plan/route cache between worker processes (requires `pip install redis`)
# REDIS_URL=redis://localhost:6379/0

API_THROTTLE_RATE=120/minute
